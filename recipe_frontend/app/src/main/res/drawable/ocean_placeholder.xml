<?xml version="1.0" encoding="utf-8"?>
<!--
  Ocean Professional placeholder drawable.
  Soft blue gradient background with a central circle accent using the primary color (#2563EB).
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background rounded rectangle with subtle blue/gray gradient -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <gradient
                android:startColor="#E6EFFD"
                android:endColor="#F6F8FC"
                android:angle="45" />
        </shape>
    </item>

    <!-- Center primary blue circle to suggest an image placeholder -->
    <item
        android:width="64dp"
        android:height="64dp"
        android:gravity="center">
        <shape android:shape="oval">
            <size android:width="64dp" android:height="64dp" />
            <solid android:color="#2563EB" />
        </shape>
    </item>

    <!-- Inner light circle for depth -->
    <item
        android:width="36dp"
        android:height="36dp"
        android:gravity="center">
        <shape android:shape="oval">
            <size android:width="36dp" android:height="36dp" />
            <solid android:color="#FFFFFFFF" />
            <stroke android:width="1dp" android:color="#1A2563EB" />
        </shape>
    </item>
</layer-list>
